# setup_ai.bat으로 설정하는 것을 권장합니다.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# 이 파일을 .env로 복사한 뒤 로컬 PC에서 입력하세요. 채팅에 키를 보내지 마세요.
OPENAI_API_KEY=
# 계정에서 사용 가능한 Responses API 지원 텍스트 모델 ID
OPENAI_MODEL=
NOTION_TOKEN=
# 데이터베이스 ID가 아니라 일반 부모 페이지 ID
NOTION_PARENT_PAGE_ID=
# 선택: Crossref 요청용 연락 이메일
CROSSREF_EMAIL=

# 선택: 공개 PDF 검색용 이메일 (setup_fulltext.bat)
UNPAYWALL_EMAIL=
